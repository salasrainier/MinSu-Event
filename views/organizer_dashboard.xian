{{> head }}
<body class="bg-gray-100 min-h-screen">

  {{> navbar }}

  <div class="max-w-7xl mx-auto px-4 py-8">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Organizer Dashboard</h1>
        <p class="text-sm text-gray-500 mt-1">Welcome back, <span class="font-semibold text-green-600">{{user.name}}</span> &mdash; {{user.department}}</p>
      </div>
      <a href="/submit-event" class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-lg transition shadow">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Submit New Event
      </a>
    </div>

    <!-- Alert Messages -->
    {{#if success_msg}}
      <div class="mb-6 p-4 bg-green-50 border-l-4 border-green-500 text-green-700 rounded-lg flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-sm font-medium">{{success_msg}}</p>
      </div>
    {{/if}}
    {{#if error_msg}}
      <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded-lg flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-sm font-medium">{{error_msg}}</p>
      </div>
    {{/if}}

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">

      <!-- Total -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex items-center gap-4">
        <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Total</p>
          <p class="text-2xl font-bold text-gray-900">{{events.length}}</p>
        </div>
      </div>

      <!-- Pending -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex items-center gap-4">
        <div class="w-12 h-12 bg-yellow-100 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Pending</p>
          <p class="text-2xl font-bold text-yellow-600" id="pendingCount">0</p>
        </div>
      </div>

      <!-- Approved -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex items-center gap-4">
        <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Approved</p>
          <p class="text-2xl font-bold text-green-600" id="approvedCount">0</p>
        </div>
      </div>

      <!-- Denied -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex items-center gap-4">
        <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Denied</p>
          <p class="text-2xl font-bold text-red-600" id="deniedCount">0</p>
        </div>
      </div>

    </div>

    <!-- Events Table -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">

      <!-- Table Header -->
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          My Events
        </h2>
        <!-- Filter Tabs -->
        <div class="flex gap-1 bg-gray-100 rounded-lg p-1 text-xs font-medium">
          <button onclick="filterEvents('all')" id="tab-all" class="tab-btn px-3 py-1.5 rounded-md bg-white text-gray-800 shadow-sm transition">All</button>
          <button onclick="filterEvents('Pending')" id="tab-Pending" class="tab-btn px-3 py-1.5 rounded-md text-gray-500 hover:text-gray-700 transition">Pending</button>
          <button onclick="filterEvents('Approved')" id="tab-Approved" class="tab-btn px-3 py-1.5 rounded-md text-gray-500 hover:text-gray-700 transition">Approved</button>
          <button onclick="filterEvents('Denied')" id="tab-Denied" class="tab-btn px-3 py-1.5 rounded-md text-gray-500 hover:text-gray-700 transition">Denied</button>
        </div>
      </div>

      {{#if events.length}}
      <!-- Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 text-xs text-gray-500 uppercase tracking-wide">
              <th class="px-6 py-3 text-left font-semibold">Event</th>
              <th class="px-6 py-3 text-left font-semibold">Department</th>
              <th class="px-6 py-3 text-left font-semibold">Date</th>
              <th class="px-6 py-3 text-left font-semibold">Venue</th>
              <th class="px-6 py-3 text-left font-semibold">Participants</th>
              <th class="px-6 py-3 text-left font-semibold">Status</th>
              <th class="px-6 py-3 text-left font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody id="eventsTableBody" class="divide-y divide-gray-100">
            <!-- Filled by JS -->
          </tbody>
        </table>
      </div>

      <!-- Empty filter result -->
      <div id="emptyFilter" class="hidden py-16 text-center">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <p class="text-gray-400 text-sm">No events match this filter.</p>
      </div>

      {{else}}
      <!-- No events at all -->
      <div class="py-20 text-center">
        <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
        </svg>
        <h3 class="text-lg font-semibold text-gray-700 mb-1">No Events Yet</h3>
        <p class="text-gray-400 text-sm mb-6">Submit your first event to get started.</p>
        <a href="/submit-event" class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Submit Event
        </a>
      </div>
      {{/if}}

    </div>
  </div>

  {{> footer }}

  <script>
    const events = {{{json events}}};

    // Stats
    document.getElementById('pendingCount').textContent  = events.filter(e => e.status === 'Pending').length;
    document.getElementById('approvedCount').textContent = events.filter(e => e.status === 'Approved').length;
    document.getElementById('deniedCount').textContent   = events.filter(e => e.status === 'Denied').length;

    // Participant counts cache
    const participantCounts = {};

    async function fetchParticipantCount(eventId) {
      if (participantCounts[eventId] !== undefined) return participantCounts[eventId];
      try {
        const res = await fetch(`/api/events/${eventId}/stats`);
        if (res.ok) {
          const data = await res.json();
          participantCounts[eventId] = data.participants?.length || 0;
        } else {
          participantCounts[eventId] = 0;
        }
      } catch { participantCounts[eventId] = 0; }
      return participantCounts[eventId];
    }

    function statusBadge(status) {
      const map = {
        Pending:  'bg-yellow-100 text-yellow-700 border border-yellow-300',
        Approved: 'bg-green-100 text-green-700 border border-green-300',
        Denied:   'bg-red-100 text-red-700 border border-red-300',
      };
      return `<span class="px-2.5 py-1 rounded-full text-xs font-semibold ${map[status] || 'bg-gray-100 text-gray-600'}">${status}</span>`;
    }

    function formatDate(d) {
      return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    async function renderTable(filter = 'all') {
      const tbody = document.getElementById('eventsTableBody');
      const emptyFilter = document.getElementById('emptyFilter');
      if (!tbody) return;

      const filtered = filter === 'all' ? events : events.filter(e => e.status === filter);

      if (filtered.length === 0) {
        tbody.innerHTML = '';
        emptyFilter?.classList.remove('hidden');
        return;
      }
      emptyFilter?.classList.add('hidden');

      // Fetch all participant counts in parallel
      await Promise.all(filtered.map(e => fetchParticipantCount(e.id)));

      tbody.innerHTML = filtered.map(event => `
        <tr class="hover:bg-gray-50 transition event-row" data-status="${event.status}">
          <td class="px-6 py-4">
            <div class="font-semibold text-gray-900 text-sm">${event.event_title}</div>
            <div class="text-xs text-gray-400 mt-0.5">Submitted ${formatDate(event.created_at)}</div>
          </td>
          <td class="px-6 py-4 text-gray-600 text-sm">${event.department}</td>
          <td class="px-6 py-4 text-gray-600 text-sm whitespace-nowrap">${formatDate(event.event_date)}</td>
          <td class="px-6 py-4 text-gray-600 text-sm">${event.venue}</td>
          <td class="px-6 py-4">
            <div class="flex items-center gap-1.5 text-sm text-gray-600">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              ${participantCounts[event.id] || 0}
            </div>
          </td>
          <td class="px-6 py-4">${statusBadge(event.status)}</td>
          <td class="px-6 py-4">
            <div class="flex items-center gap-2">
              ${event.proposal_file ? `
                <button onclick="viewProposal('${event.proposal_file}')"
                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg text-xs font-semibold transition">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                  View
                </button>` : ''}
              ${event.status === 'Approved' ? `
                <button onclick="openAttendanceModal(${event.id}, '${event.event_title}')"
                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-purple-50 text-purple-700 hover:bg-purple-100 rounded-lg text-xs font-semibold transition">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                  </svg>
                  Attendance
                </button>
                <span class="inline-flex items-center gap-1 px-3 py-1.5 ${event.is_expired ? 'bg-gray-100 text-gray-500' : 'bg-green-50 text-green-700'} rounded-lg text-xs font-semibold">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  ${event.is_expired ? 'Expired' : 'Active'}
                </span>` : ''}
            </div>
          </td>
        </tr>
      `).join('');
    }

    function filterEvents(status) {
      // Update tab styles
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-white', 'text-gray-800', 'shadow-sm');
        btn.classList.add('text-gray-500');
      });
      const active = document.getElementById(`tab-${status}`);
      if (active) {
        active.classList.add('bg-white', 'text-gray-800', 'shadow-sm');
        active.classList.remove('text-gray-500');
      }
      renderTable(status);
    }

    // Initial render
    if (events.length > 0) renderTable('all');
  </script>

  <!-- Proposal Viewer Modal -->
  <div id="proposalModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm" style="display:none;">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl flex flex-col overflow-hidden" style="height:85vh;">

      <!-- Modal Header -->
      <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 flex-shrink-0">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span class="font-semibold text-gray-800 text-sm" id="proposalFileName">Proposal</span>
        </div>
        <div class="flex items-center gap-2">
          <a id="proposalDownloadBtn" href="#" download
             class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Download
          </a>
          <button onclick="closeProposal()" class="p-1.5 hover:bg-gray-100 rounded-lg transition text-gray-500 hover:text-gray-800">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Modal Body -->
      <div class="flex-1 overflow-hidden bg-gray-50" id="proposalBody" style="min-height:0;"></div>

    </div>
  </div>

  <script>
    function viewProposal(filePath) {
      const modal       = document.getElementById('proposalModal');
      const body        = document.getElementById('proposalBody');
      const nameEl      = document.getElementById('proposalFileName');
      const downloadBtn = document.getElementById('proposalDownloadBtn');

      const fileName = filePath.split('/').pop();
      const ext = fileName.split('.').pop().toLowerCase();

      nameEl.textContent = decodeURIComponent(fileName);
      downloadBtn.href = filePath;

      if (ext === 'pdf') {
        body.innerHTML = `<iframe src="${filePath}" class="w-full h-full border-0" style="height:100%;" title="Proposal"></iframe>`;

      } else if (['png','jpg','jpeg','gif','webp','svg'].includes(ext)) {
        body.innerHTML = `
          <div class="w-full h-full flex items-center justify-center p-6 overflow-auto">
            <img src="${filePath}" alt="Proposal" class="max-w-full max-h-full object-contain rounded-lg shadow-lg" />
          </div>`;

      } else if (['doc','docx','ppt','pptx','xls','xlsx'].includes(ext)) {
        const encoded = encodeURIComponent(window.location.origin + filePath);
        body.innerHTML = `
          <div class="w-full h-full flex flex-col">
            <div class="bg-yellow-50 border-b border-yellow-200 px-4 py-2 text-xs text-yellow-700 flex items-center gap-2 flex-shrink-0">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Viewing via Google Docs Viewer. If it doesn't load, click Download.
            </div>
            <iframe src="https://docs.google.com/viewer?url=${encoded}&embedded=true"
                    class="flex-1 border-0 w-full" style="min-height:0;" title="Proposal"></iframe>
          </div>`;

      } else {
        body.innerHTML = `
          <div class="w-full h-full flex flex-col items-center justify-center gap-4 text-gray-500">
            <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <p class="text-sm">Preview not available for <strong>.${ext}</strong> files.</p>
            <a href="${filePath}" download class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition">
              Download File
            </a>
          </div>`;
      }

      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeProposal() {
      const modal = document.getElementById('proposalModal');
      const body  = document.getElementById('proposalBody');
      modal.style.display = 'none';
      body.innerHTML = '';
      document.body.style.overflow = '';
    }

    document.getElementById('proposalModal').addEventListener('click', function(e) {
      if (e.target === this) closeProposal();
    });

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeProposal(); });
  </script>

  <!-- Attendance Modal -->
  <div id="attendanceModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm" style="display:none;">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl flex flex-col overflow-hidden" style="max-height:90vh;">

      <!-- Modal Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 flex-shrink-0">
        <div>
          <h3 class="font-bold text-gray-900 text-lg">Attendance Tracking</h3>
          <p class="text-xs text-gray-500 mt-1" id="attendanceEventTitle">Event Title</p>
        </div>
        <button onclick="closeAttendanceModal()" class="p-1.5 hover:bg-gray-100 rounded-lg transition text-gray-500 hover:text-gray-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Stats Bar -->
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex-shrink-0">
        <div class="grid grid-cols-4 gap-3 text-center">
          <div class="bg-white rounded-lg p-3 border border-gray-200">
            <div class="text-xl font-bold text-gray-900" id="totalStats">0</div>
            <div class="text-xs text-gray-500 font-medium">Total</div>
          </div>
          <div class="bg-white rounded-lg p-3 border border-blue-200">
            <div class="text-xl font-bold text-blue-600" id="registeredStats">0</div>
            <div class="text-xs text-gray-500 font-medium">Registered</div>
          </div>
          <div class="bg-white rounded-lg p-3 border border-green-200">
            <div class="text-xl font-bold text-green-600" id="attendedStats">0</div>
            <div class="text-xs text-gray-500 font-medium">Attended</div>
          </div>
          <div class="bg-white rounded-lg p-3 border border-purple-200">
            <div class="text-xl font-bold text-purple-600" id="attendanceRateStats">0%</div>
            <div class="text-xs text-gray-500 font-medium">Attendance %</div>
          </div>
        </div>
      </div>

      <!-- Participants List -->
      <div class="flex-1 overflow-y-auto" id="participantsList" style="min-height:0;">
        <div class="p-6 text-center text-gray-500">
          <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-sm">Loading participants...</p>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-2 flex-shrink-0 bg-gray-50">
        <button onclick="closeAttendanceModal()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg text-sm font-semibold transition">
          Close
        </button>
      </div>

    </div>
  </div>

  <style>
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  </style>

  <script>
    let currentEventId = null;
    const userId = "{{user.id}}";

    async function openAttendanceModal(eventId, eventTitle) {
      currentEventId = eventId;
      const modal = document.getElementById('attendanceModal');
      document.getElementById('attendanceEventTitle').textContent = eventTitle;
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      
      // Load participants and stats
      await loadAttendanceData(eventId);
    }

    function closeAttendanceModal() {
      const modal = document.getElementById('attendanceModal');
      modal.style.display = 'none';
      document.body.style.overflow = '';
      currentEventId = null;
    }

    async function loadAttendanceData(eventId) {
      const participantsList = document.getElementById('participantsList');
      
      try {
        // Fetch participants
        const participantsRes = await fetch(`/api/attendance/participants/${eventId}?organizerId=${userId}`);
        if (!participantsRes.ok) {
          throw new Error('Failed to fetch participants');
        }
        const participantsData = await participantsRes.json();
        const participants = participantsData.participants || [];

        // Fetch stats
        const statsRes = await fetch(`/api/attendance/stats?eventId=${eventId}&organizerId=${userId}`);
        const statsData = statsRes.ok ? await statsRes.json() : { stats: {} };
        const stats = statsData.stats || {};

        // Update stats
        document.getElementById('totalStats').textContent = stats.total || 0;
        document.getElementById('registeredStats').textContent = stats.registered || 0;
        document.getElementById('attendedStats').textContent = stats.attended || 0;
        document.getElementById('attendanceRateStats').textContent = stats.attendanceRate || '0%';

        // Render participants
        if (participants.length === 0) {
          participantsList.innerHTML = `
            <div class="p-8 text-center">
              <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <p class="text-gray-500 text-sm">No participants yet</p>
            </div>`;
          return;
        }

        participantsList.innerHTML = participants.map(p => `
          <div class="px-6 py-4 border-b border-gray-100 hover:bg-gray-50 transition flex items-center justify-between">
            <div class="flex-1">
              <div class="font-semibold text-gray-900 text-sm">${p.name}</div>
              <div class="text-xs text-gray-500 mt-0.5">${p.email}</div>
              <div class="flex gap-2 mt-2 text-xs">
                <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded">Course: ${p.course || 'N/A'}</span>
                <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded">Year: ${p.year || 'N/A'}</span>
                <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded">${p.department || 'N/A'}</span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              ${p.status === 'attended' ? `
                <span class="px-3 py-1.5 bg-green-100 text-green-700 rounded-lg text-xs font-semibold">✓ Attended</span>
                <button onclick="toggleAttendance(${p.participantId}, ${eventId}, false)"
                   class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 rounded-lg text-xs font-semibold transition">
                  Unmark
                </button>
              ` : `
                <span class="px-3 py-1.5 bg-blue-100 text-blue-700 rounded-lg text-xs font-semibold">○ Registered</span>
                <button onclick="toggleAttendance(${p.participantId}, ${eventId}, true)"
                   class="px-3 py-1.5 bg-green-50 hover:bg-green-100 text-green-700 rounded-lg text-xs font-semibold transition">
                  Mark Attended
                </button>
              `}
            </div>
          </div>
        `).join('');

      } catch (error) {
        console.error('Error loading attendance data:', error);
        participantsList.innerHTML = `
          <div class="p-8 text-center">
            <svg class="w-12 h-12 text-red-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-red-600 text-sm">Failed to load participants</p>
            <p class="text-gray-500 text-xs mt-1">${error.message}</p>
          </div>`;
      }
    }

    async function toggleAttendance(participantId, eventId, markAsAttended) {
      try {
        const endpoint = markAsAttended ? '/api/attendance/mark' : '/api/attendance/unmark';
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            participantId,
            eventId,
            organizerId: userId
          })
        });

        if (!res.ok) {
          const errorData = await res.json();
          throw new Error(errorData.message || 'Failed to update attendance');
        }

        // Reload attendance data
        await loadAttendanceData(eventId);
      } catch (error) {
        console.error('Error updating attendance:', error);
        alert('Error: ' + error.message);
      }
    }

    document.getElementById('attendanceModal').addEventListener('click', function(e) {
      if (e.target === this) closeAttendanceModal();
    });

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAttendanceModal(); });
  </script>

</body>
</html>
