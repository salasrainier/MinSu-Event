{{> head }}
<body class="bg-gradient-to-br from-indigo-50 via-purple-50 to-indigo-50 min-h-screen">

  <!-- Top Navigation Bar -->
  <nav class="bg-gradient-to-r from-indigo-700 to-purple-600 shadow-lg sticky top-0 z-40">
    <div class="container mx-auto px-4 py-4 flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold text-white flex items-center gap-2">
          <img src="/uploads/OIP.jpg" alt="MSU Logo" class="w-8 h-8 rounded-full object-cover" />
          <span>MinSU Events</span>
        </h1>
      </div>
      <div class="flex items-center gap-6">
        <a href="/" class="text-indigo-50 hover:text-white transition font-medium text-sm">
          🏠 Home
        </a>
        <a href="/events" class="text-indigo-50 hover:text-white transition font-medium text-sm">
          🎉 Browse Events
        </a>
        <a href="/my-participation" class="text-indigo-50 hover:text-white transition font-medium text-sm font-bold border-b-2 border-white">
          📋 My Events
        </a>
        <div class="flex items-center gap-2 text-white text-sm">
          <span>👤</span>
          <span>{{user.name}}</span>
        </div>
        <a href="/auth/logout" class="px-4 py-2 bg-white/20 text-white rounded-lg hover:bg-white/30 transition font-medium text-sm border border-white/30">
          🚪 Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto px-4 py-12">
    
    <!-- Header Section -->
    <div class="mb-10">
      <h1 class="text-4xl font-bold text-indigo-800 mb-2">📋 My Participating Events</h1>
      <p class="text-gray-600">Events you've joined and are participating in</p>
    </div>

    <!-- Alert Messages -->
    {{#if success_msg}}
      <div class="mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg flex items-start gap-3 animate-slideDown">
        <span class="text-xl">✅</span>
        <div>
          <p class="font-semibold">Success!</p>
          <p class="text-sm">{{success_msg}}</p>
        </div>
      </div>
    {{/if}}

    {{#if error_msg}}
      <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg flex items-start gap-3 animate-slideDown">
        <span class="text-xl">❌</span>
        <div>
          <p class="font-semibold">Error</p>
          <p class="text-sm">{{error_msg}}</p>
        </div>
      </div>
    {{/if}}

    <!-- Stats -->
    <div class="grid md:grid-cols-3 gap-6 mb-10">
      <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-purple-500">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-600 text-sm font-medium">Total Events</p>
            <p class="text-3xl font-bold text-purple-600 mt-2" id="totalCount">0</p>
          </div>
          <span class="text-3xl">📊</span>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-indigo-500">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-600 text-sm font-medium">Registered</p>
            <p class="text-3xl font-bold text-indigo-600 mt-2" id="registeredCount">0</p>
          </div>
          <span class="text-3xl">✍️</span>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-green-500">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-600 text-sm font-medium">Attended</p>
            <p class="text-3xl font-bold text-green-600 mt-2" id="attendedCount">0</p>
          </div>
          <span class="text-3xl">✅</span>
        </div>
      </div>
    </div>

    <!-- Events Grid -->
    <div id="eventsContainer" class="grid md:grid-cols-2 gap-6">
      <!-- Events will load here via JavaScript -->
      <div class="col-span-full text-center py-12">
        <div class="text-gray-400 text-lg">Loading your events...</div>
      </div>
    </div>

  </div>

  {{> footer }}

  <script>
    // Load user's participated events
    async function loadMyEvents() {
      try {
        const response = await fetch('/api/my-events');
        const data = await response.json();
        
        displayEvents(data.events || []);
        updateStats(data.events || []);
      } catch (error) {
        console.error('Error loading events:', error);
        document.getElementById('eventsContainer').innerHTML = '<div class="col-span-full text-center text-red-600">Error loading events</div>';
      }
    }

    async function leaveEvent(eventId, button) {
      if (!confirm('Are you sure you want to leave this event?')) return;
      
      try {
        const response = await fetch(`/api/events/${eventId}/leave`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        
        if (data.success) {
          button.closest('.bg-white').remove();
          showNotification('Left the event', 'success');
          loadMyEvents();
        } else {
          showNotification(data.message, 'error');
        }
      } catch (error) {
        console.error('Error leaving event:', error);
        showNotification('Failed to leave event', 'error');
      }
    }

    function showNotification(message, type) {
      const notif = document.createElement('div');
      notif.className = `fixed top-4 right-4 p-4 rounded-lg text-white font-semibold ${type === 'success' ? 'bg-green-600' : 'bg-red-600'} animate-slideDown z-50`;
      notif.textContent = message;
      document.body.appendChild(notif);
      setTimeout(() => notif.remove(), 3000);
    }

    function updateStats(events) {
      const total = events.length;
      const registered = events.filter(e => e.participation_status === 'registered').length;
      const attended = events.filter(e => e.participation_status === 'attended').length;

      document.getElementById('totalCount').textContent = total;
      document.getElementById('registeredCount').textContent = registered;
      document.getElementById('attendedCount').textContent = attended;
    }

    function displayEvents(events) {
      const container = document.getElementById('eventsContainer');
      
      if (!events || events.length === 0) {
        container.innerHTML = '<div class="col-span-full text-center py-12"><div class="text-gray-400 text-lg">📭 No events yet. <a href="/events" class="text-indigo-600 hover:underline">Browse events</a> to join!</div></div>';
        return;
      }

      container.innerHTML = events.map(event => `
        <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition overflow-hidden">
          <div class="p-6">
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-gray-800 flex-1">${event.event_title}</h3>
              <span class="px-3 py-1 rounded-full text-xs font-bold ${
                event.participation_status === 'attended' ? 'bg-green-100 text-green-700' :
                event.participation_status === 'registered' ? 'bg-indigo-100 text-indigo-700' :
                'bg-gray-100 text-gray-700'
              }">
                ${event.participation_status === 'attended' ? '✅ Attended' : '✍️ Registered'}
              </span>
            </div>
            
            <div class="space-y-2 text-sm text-gray-600 mb-4">
              <p><strong>📅 Date:</strong> ${new Date(event.event_date).toLocaleDateString()}</p>
              <p><strong>⏰ Time:</strong> ${new Date(event.event_date).toLocaleTimeString()}</p>
              <p><strong>📍 Venue:</strong> ${event.venue}</p>
              <p><strong>👤 Organizer:</strong> ${event.organizer_name}</p>
              <p><strong>🏢 Department:</strong> ${event.department}</p>
              <p><strong>📌 Joined:</strong> ${new Date(event.joined_at).toLocaleDateString()}</p>
            </div>

            <p class="text-gray-700 text-sm mb-4">${event.purpose.substring(0, 100)}...</p>
            
            <div class="flex gap-2">
              ${event.proposal_file ? `<a href="${event.proposal_file}" target="_blank" class="flex-1 px-4 py-2 bg-indigo-100 text-indigo-700 rounded-lg hover:bg-indigo-200 transition text-sm font-semibold text-center">📎 View Proposal</a>` : ''}
              <button onclick="leaveEvent(${event.id}, this)" class="flex-1 px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition text-sm font-semibold">
                ✖️ Leave Event
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Load events on page load
    document.addEventListener('DOMContentLoaded', loadMyEvents);
  </script>

  <style>
    @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    .animate-slideDown { animation: slideDown 0.4s ease-out; }
  </style>

</body>
