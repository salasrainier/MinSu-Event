{{> head }}
<body class="bg-gradient-to-br from-slate-50 via-gray-50 to-green-50 min-h-screen">

  <!-- Animated Background -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none opacity-30">
    <div class="absolute top-20 left-10 w-96 h-96 bg-green-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob"></div>
    <div class="absolute top-40 right-10 w-96 h-96 bg-emerald-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"></div>
    <div class="absolute -bottom-8 left-1/2 w-96 h-96 bg-green-300 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-4000"></div>
  </div>

  <!-- Top Navigation Bar -->
  <nav class="bg-white/80 backdrop-blur-xl shadow-lg sticky top-0 z-50 border-b border-gray-200">
    <div class="container mx-auto px-6 py-4">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-gradient-to-br from-green-600 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg">
            <img src="/uploads/OIP.jpg" alt="MSU Logo" class="w-8 h-8 rounded-lg object-cover" />
          </div>
          <div>
            <h1 class="text-xl font-bold text-gray-800">MinSU Admin Panel</h1>
            <p class="text-xs text-gray-500">Event Management System</p>
          </div>
        </div>
        
        <div class="flex items-center gap-4">
          <a href="/admin/dashboard" class="flex items-center gap-2 text-gray-600 hover:text-green-600 transition font-medium text-sm px-3 py-2 rounded-lg hover:bg-green-50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            Dashboard
          </a>
          <a href="/admin/analytics" class="flex items-center gap-2 text-green-600 font-medium text-sm px-3 py-2 rounded-lg bg-green-50 border-b-2 border-green-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            Analytics
          </a>
          
          <div class="h-8 w-px bg-gray-300"></div>
          
          <div class="flex items-center gap-2 px-3 py-2 bg-gray-100 rounded-lg">
            <div class="w-8 h-8 bg-gradient-to-br from-green-600 to-emerald-600 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <span class="text-sm font-semibold text-gray-700">{{user.name}}</span>
          </div>
          
          <a href="/auth/logout" class="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-lg hover:from-red-600 hover:to-red-700 transition font-medium text-sm shadow-md hover:shadow-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            Logout
          </a>
        </div>
      </div>
    </div>
  </nav>

  <div class="container mx-auto px-6 py-8 relative z-10">
    
    <!-- Header -->
    <div class="mb-8 animate-fadeIn">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 bg-gradient-to-br from-green-600 to-emerald-600 rounded-2xl flex items-center justify-center shadow-xl animate-float">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold text-gray-800 mb-1">Analytics Dashboard</h1>
            <p class="text-gray-600 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Real-time system statistics and insights
            </p>
          </div>
        </div>
        
        <button onclick="location.reload()" class="flex items-center gap-2 px-4 py-2 bg-white border-2 border-gray-200 text-gray-700 rounded-xl hover:border-green-500 hover:text-green-600 transition font-semibold shadow-sm hover:shadow-md">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Refresh
        </button>
      </div>
    </div>

    <!-- Key Statistics Cards -->
    <div class="grid md:grid-cols-5 gap-4 mb-8">
      <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-blue-500 hover:shadow-lg transition">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-600 text-sm font-medium">Total Events</p>
            <p class="text-4xl font-bold text-blue-600 mt-3">{{stats.totalEvents}}</p>
          </div>
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-yellow-500 hover:shadow-lg transition">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-600 text-sm font-medium">Pending Events</p>
            <p class="text-4xl font-bold text-yellow-600 mt-3">{{stats.pendingEvents}}</p>
          </div>
          <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-green-500 hover:shadow-lg transition">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-600 text-sm font-medium">Approved Events</p>
            <p class="text-4xl font-bold text-green-600 mt-3">{{stats.approvedEvents}}</p>
          </div>
          <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-red-500 hover:shadow-lg transition">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-600 text-sm font-medium">Denied Events</p>
            <p class="text-4xl font-bold text-red-600 mt-3">{{stats.deniedEvents}}</p>
          </div>
          <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l-2-2m0 0l-2-2m2 2l2-2m-2 2l-2 2m2-2l2 2M19 12a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-purple-500 hover:shadow-lg transition">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-gray-600 text-sm font-medium">Total Users</p>
            <p class="text-4xl font-bold text-purple-600 mt-3">{{stats.totalUsers}}</p>
          </div>
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 8.646 4 4 0 010-8.646M12 14a7 7 0 100 14 7 7 0 000-14z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts Section -->
    <div class="grid md:grid-cols-3 gap-6 mb-8">
      <!-- Pie Chart: Event Status Distribution -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          Event Status Distribution
        </h2>
        <div class="relative h-80">
          <canvas id="pieChart"></canvas>
        </div>
      </div>

      <!-- Bar Chart: Department Breakdown -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
          Events by Department
        </h2>
        <div class="relative h-80">
          <canvas id="barChart"></canvas>
        </div>
      </div>

      <!-- Line Chart: Monthly Trends -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Monthly Event Trends
        </h2>
        <div class="relative h-80">
          <canvas id="lineChart"></canvas>
        </div>
      </div>
    </div>
    <!-- User & Participation Statistics -->
    <div class="grid md:grid-cols-3 gap-6 mb-8">
      <!-- User Breakdown -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 8.646 4 4 0 010-8.646M12 14a7 7 0 100 14 7 7 0 000-14z"/>
          </svg>
          User Breakdown
        </h2>
        <div class="space-y-4">
          <div class="flex justify-between items-center pb-3 border-b">
            <span class="text-gray-600 flex items-center gap-2">
              <span class="w-3 h-3 bg-blue-500 rounded-full"></span> Participants
            </span>
            <span class="font-bold text-xl text-blue-600">{{stats.participantUsers}}</span>
          </div>
          <div class="flex justify-between items-center pb-3 border-b">
            <span class="text-gray-600 flex items-center gap-2">
              <span class="w-3 h-3 bg-green-500 rounded-full"></span> Organizers
            </span>
            <span class="font-bold text-xl text-green-600">{{stats.organizerUsers}}</span>
          </div>
          <div class="flex justify-between items-center pb-3 border-b">
            <span class="text-gray-600 flex items-center gap-2">
              <span class="w-3 h-3 bg-red-500 rounded-full"></span> Admins
            </span>
            <span class="font-bold text-xl text-red-600">{{stats.adminUsers}}</span>
          </div>
          <div class="flex justify-between items-center pt-2">
            <span class="text-gray-700 font-semibold">Total</span>
            <span class="font-bold text-2xl text-purple-600">{{stats.totalUsers}}</span>
          </div>
        </div>
      </div>

      <!-- Participation Statistics -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1m2-1v2.5M2 7l2-1 2 1M4 7v2.5M4 7l2 1"/>
          </svg>
          Participation Stats
        </h2>
        <div class="space-y-4">
          <div class="flex justify-between items-center pb-3 border-b">
            <span class="text-gray-600">Unique Participants</span>
            <span class="font-bold text-2xl text-indigo-600">{{stats.totalParticipants}}</span>
          </div>
          <div class="flex justify-between items-center pb-3 border-b">
            <span class="text-gray-600">Total Registrations</span>
            <span class="font-bold text-2xl text-pink-600">{{stats.totalParticipations}}</span>
          </div>
          {{#if stats.totalEvents}}
          <div class="flex justify-between items-center pt-2">
            <span class="text-gray-600">Approval Rate</span>
            <span class="font-bold text-lg text-green-600">{{stats.approvalRate}}%</span>
          </div>
          {{/if}}
        </div>
      </div>

      <!-- Approval Rates -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          Event Status Rates
        </h2>
        <div class="space-y-4">
          {{#if stats.totalEvents}}
          <div class="flex justify-between items-center pb-3 border-b">
            <span class="text-gray-600">Approval Rate</span>
            <div class="flex items-center gap-2">
              <div class="w-24 bg-gray-200 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full" style="width: {{stats.approvalRate}}%"></div>
              </div>
              <span class="font-bold text-green-600 w-10">{{stats.approvalRate}}%</span>
            </div>
          </div>
          <div class="flex justify-between items-center pb-3 border-b">
            <span class="text-gray-600">Denial Rate</span>
            <div class="flex items-center gap-2">
              <div class="w-24 bg-gray-200 rounded-full h-2">
                <div class="bg-red-500 h-2 rounded-full" style="width: {{stats.denialRate}}%"></div>
              </div>
              <span class="font-bold text-red-600 w-10">{{stats.denialRate}}%</span>
            </div>
          </div>
          {{else}}
          <p class="text-gray-500 text-center py-4">No events yet</p>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- Monthly Trends Table -->
    <div class="bg-white rounded-xl shadow-md p-6 mb-8">
      <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Monthly Trends Detail
      </h2>
      {{#if stats.monthlyTrends.length}}
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b-2 border-gray-300">
              <th class="text-left py-3 px-4 font-semibold text-gray-700">Month</th>
              <th class="text-center py-3 px-4 font-semibold text-gray-700">Events</th>
              <th class="text-left py-3 px-4 font-semibold text-gray-700">Trend</th>
            </tr>
          </thead>
          <tbody>
            {{#each stats.monthlyTrends}}
            <tr class="border-b hover:bg-gray-50 transition">
              <td class="py-3 px-4 font-medium text-gray-800">{{this.monthYear}}</td>
              <td class="py-3 px-4 text-center font-bold text-blue-600">{{this.count}}</td>
              <td class="py-3 px-4">
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-blue-500 h-2 rounded-full" style="width: {{this.percentage}}%"></div>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <p class="text-gray-500 text-center py-8">No trend data available</p>
      {{/if}}
    </div>

    <!-- Recent Activity -->
    <div class="bg-white rounded-xl shadow-md p-6">
      <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Recent Events Activity
      </h2>
      {{#if stats.recentActivity.length}}
      <div class="space-y-4">
        {{#each stats.recentActivity}}
        <div class="flex justify-between items-start pb-4 border-b hover:bg-gray-50 p-2 rounded transition">
          <div class="flex-1">
            <p class="font-semibold text-gray-800">{{this.event_title}}</p>
            <p class="text-sm text-gray-600">by {{this.organizer_name}}</p>
          </div>
          <div class="flex items-center gap-3">
            {{#eq this.status "Approved"}}
            <span class="px-3 py-1 bg-green-100 text-green-800 text-xs font-bold rounded-full">✅ {{this.status}}</span>
            {{else}}
            {{#eq this.status "Pending"}}
            <span class="px-3 py-1 bg-yellow-100 text-yellow-800 text-xs font-bold rounded-full">⏳ {{this.status}}</span>
            {{else}}
            {{#eq this.status "Denied"}}
            <span class="px-3 py-1 bg-red-100 text-red-800 text-xs font-bold rounded-full">❌ {{this.status}}</span>
            {{/eq}}
            {{/eq}}
            {{/eq}}
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="text-gray-500 text-center py-8">No recent activity</p>
      {{/if}}
    </div>

  </div>

  <!-- Chart.js Library -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  
  <script>
    // Parse chart data from server
    const pieChartData = {{{stats.pieChartData}}};
    const barChartData = {{{stats.barChartData}}};
    const lineChartData = {{{stats.lineChartData}}};

    // Pie Chart: Event Status
    const pieCtx = document.getElementById('pieChart').getContext('2d');
    new Chart(pieCtx, {
      type: 'doughnut',
      data: {
        labels: pieChartData.labels,
        datasets: [{
          data: pieChartData.data,
          backgroundColor: pieChartData.backgroundColor,
          borderColor: pieChartData.borderColor,
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              padding: 15,
              font: { size: 13, weight: '600' }
            }
          }
        }
      }
    });

    // Bar Chart: Department Breakdown
    const barCtx = document.getElementById('barChart').getContext('2d');
    new Chart(barCtx, {
      type: 'bar',
      data: {
        labels: barChartData.labels,
        datasets: [{
          label: 'Events',
          data: barChartData.data,
          backgroundColor: barChartData.backgroundColor,
          borderColor: barChartData.borderColor,
          borderWidth: 2,
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: true,
            labels: { padding: 15, font: { size: 13, weight: '600' } }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { stepSize: 1 }
          }
        }
      }
    });

    // Line Chart: Monthly Trends
    const lineCtx = document.getElementById('lineChart').getContext('2d');
    new Chart(lineCtx, {
      type: 'line',
      data: {
        labels: lineChartData.labels,
        datasets: [{
          label: 'Events',
          data: lineChartData.data,
          borderColor: lineChartData.borderColor,
          backgroundColor: lineChartData.backgroundColor,
          tension: lineChartData.tension,
          fill: true,
          pointRadius: 5,
          pointBackgroundColor: lineChartData.borderColor,
          pointBorderColor: '#fff',
          pointBorderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: true,
            labels: { padding: 15, font: { size: 13, weight: '600' } }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { stepSize: 1 }
          }
        }
      }
    });
  </script>

  {{> footer }}

</body>
</html>
