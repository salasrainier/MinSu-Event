<!-- Consistent Navigation Bar -->
<nav class="bg-white shadow-sm sticky top-0 z-50 border-b border-gray-300">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between items-center h-14">
      <!-- Left: Logo -->
      <div class="flex items-center gap-3">
        <img src="/uploads/OIP.jpg" alt="MSU Logo" class="w-10 h-10 rounded-full object-cover" />
        <h1 class="text-xl font-bold text-green-600 hidden sm:block">MinSU Events</h1>
      </div>

      <!-- Center: Navigation Icons -->
      <div class="flex items-center gap-1">
        <!-- Home -->
        <a href="/" class="px-6 py-2 {{#ifCond currentPage '===' 'home'}}text-blue-600 bg-blue-50 border-b-4 border-blue-600{{else}}text-gray-600 hover:bg-gray-100{{/ifCond}} rounded-lg transition flex items-center gap-2" title="Home">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
        </a>
        
        <!-- Feed -->
        <a href="/api/feed" class="px-6 py-2 {{#ifCond currentPage '===' 'feed'}}text-blue-600 bg-blue-50 border-b-4 border-blue-600{{else}}text-gray-600 hover:bg-gray-100{{/ifCond}} rounded-lg transition flex items-center gap-2" title="Event Feed">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
        </a>
        
        <!-- Dashboard (Role-based) -->
        {{#if user}}
          {{#ifCond user.role '===' 'admin'}}
          <a href="/admin/dashboard" class="px-6 py-2 {{#ifCond currentPage '===' 'dashboard'}}text-blue-600 bg-blue-50 border-b-4 border-blue-600{{else}}text-gray-600 hover:bg-gray-100{{/ifCond}} rounded-lg transition flex items-center gap-2" title="Admin Dashboard">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </a>
          {{/ifCond}}
          {{#ifCond user.role '===' 'organizer'}}
          <a href="/organizer/dashboard" class="px-6 py-2 {{#ifCond currentPage '===' 'dashboard'}}text-blue-600 bg-blue-50 border-b-4 border-blue-600{{else}}text-gray-600 hover:bg-gray-100{{/ifCond}} rounded-lg transition flex items-center gap-2" title="Organizer Dashboard">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </a>
          {{/ifCond}}
          {{#ifCond user.role '===' 'participant'}}
          <a href="/participant/dashboard" class="px-6 py-2 {{#ifCond currentPage '===' 'dashboard'}}text-blue-600 bg-blue-50 border-b-4 border-blue-600{{else}}text-gray-600 hover:bg-gray-100{{/ifCond}} rounded-lg transition flex items-center gap-2" title="Participant Dashboard">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </a>
          {{/ifCond}}
        {{/if}}
      </div>

      <!-- Right: User Profile Dropdown -->
      <div class="relative">
        <button id="profileDropdownBtn" class="flex items-center gap-2 px-3 py-1.5 bg-gray-100 rounded-full hover:bg-gray-200 cursor-pointer transition">
          {{#if user.profile_picture}}
          <img src="{{user.profile_picture}}" alt="{{user.name}}" class="w-8 h-8 rounded-full object-cover border-2 border-green-500" />
          {{else}}
          <div class="w-8 h-8 bg-gradient-to-br from-green-500 to-emerald-600 rounded-full flex items-center justify-center text-white font-bold text-xs">
            {{substring user.name 0 1}}
          </div>
          {{/if}}
          <span class="font-semibold text-gray-800 text-sm hidden sm:inline">{{user.name}}</span>
          <svg class="w-4 h-4 text-gray-600 transition-transform" id="dropdownArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div id="profileDropdown" class="hidden absolute right-0 mt-2 w-72 bg-white rounded-2xl shadow-2xl border-2 border-gray-200 overflow-hidden z-50 animate-dropdown">
          <!-- Profile Header -->
          <div class="bg-gradient-to-r from-green-500 to-emerald-600 p-6 text-white">
            <div class="flex items-center gap-4">
              {{#if user.profile_picture}}
              <img src="{{user.profile_picture}}" alt="{{user.name}}" class="w-16 h-16 rounded-full object-cover border-4 border-white shadow-lg" />
              {{else}}
              <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-green-600 font-black text-2xl shadow-lg">
                {{substring user.name 0 1}}
              </div>
              {{/if}}
              <div class="flex-1">
                <h3 class="font-bold text-lg">{{user.name}}</h3>
                <p class="text-xs text-green-100 capitalize">{{user.role}}</p>
                <p class="text-xs text-green-100 mt-1">{{user.email}}</p>
              </div>
            </div>
          </div>

          <!-- Menu Items -->
          <div class="p-2">
            <a href="/profile" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-100 rounded-xl transition group">
              <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-gray-800 text-sm">My Profile</p>
                <p class="text-xs text-gray-500">View and edit profile</p>
              </div>
            </a>

            {{#ifCond user.role '===' 'organizer'}}
            <a href="/organizer/dashboard" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-100 rounded-xl transition group">
              <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition">
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-gray-800 text-sm">My Dashboard</p>
                <p class="text-xs text-gray-500">Manage events</p>
              </div>
            </a>
            {{/ifCond}}

            {{#ifCond user.role '===' 'participant'}}
            <a href="/participant/dashboard" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-100 rounded-xl transition group">
              <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition">
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-gray-800 text-sm">My Dashboard</p>
                <p class="text-xs text-gray-500">View my events</p>
              </div>
            </a>
            {{/ifCond}}

            <a href="/settings" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-100 rounded-xl transition group">
              <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center group-hover:bg-gray-200 transition">
                <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-gray-800 text-sm">Settings</p>
                <p class="text-xs text-gray-500">Account preferences</p>
              </div>
            </a>

            <div class="border-t border-gray-200 my-2"></div>

            <a href="/auth/logout" class="flex items-center gap-3 px-4 py-3 hover:bg-red-50 rounded-xl transition group">
              <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center group-hover:bg-red-200 transition">
                <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-red-600 text-sm">Logout</p>
                <p class="text-xs text-red-400">Sign out of account</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>


<script>
  // Profile Dropdown Toggle
  const profileBtn = document.getElementById('profileDropdownBtn');
  const profileDropdown = document.getElementById('profileDropdown');
  const dropdownArrow = document.getElementById('dropdownArrow');

  if (profileBtn && profileDropdown) {
    profileBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      profileDropdown.classList.toggle('hidden');
      dropdownArrow.classList.toggle('rotate-180');
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!profileBtn.contains(e.target) && !profileDropdown.contains(e.target)) {
        profileDropdown.classList.add('hidden');
        dropdownArrow.classList.remove('rotate-180');
      }
    });
  }
</script>

<style>
  @keyframes dropdown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-dropdown {
    animation: dropdown 0.2s ease-out;
  }

  #dropdownArrow {
    transition: transform 0.3s ease;
  }

  .rotate-180 {
    transform: rotate(180deg);
  }
</style>
