{{> head }}
<body class="bg-gradient-to-br from-white via-blue-50 to-white min-h-screen">

  <!-- Top Navigation Bar -->
  <nav class="bg-gradient-to-r from-green-700 to-emerald-700 shadow-lg sticky top-0 z-40">
    <div class="container mx-auto px-4 py-4 flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold text-white flex items-center gap-2">
          <img src="/uploads/OIP.jpg" alt="MSU Logo" class="w-8 h-8 rounded-full object-cover" />
          <span>MinSU Events</span>
        </h1>
      </div>
      <div class="flex items-center gap-6">
        <a href="/dashboard" class="text-green-50 hover:text-white transition font-medium">📊 Dashboard</a>
        <a href="/notifications" class="text-green-50 hover:text-white transition font-medium relative">
          🔔 Notifications
        </a>
        <a href="/submit-event" class="px-4 py-2 bg-yellow-400 text-green-700 rounded-lg hover:bg-yellow-300 transition font-bold text-sm">
          ➕ New Event
        </a>
        <a href="/auth/logout" class="px-4 py-2 bg-white/20 text-white rounded-lg hover:bg-white/30 transition font-medium text-sm border border-white/30">
          🚪 Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto px-4 py-8">
    
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-800 mb-2">📅 Event Calendar</h1>
      <p class="text-gray-600">View all your events in calendar format</p>
    </div>

    <!-- Calendar Controls -->
    <div class="bg-white rounded-xl shadow-md p-6 mb-8">
      <div class="grid md:grid-cols-4 gap-4 mb-6">
        <!-- Month Selector -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">📆 Month</label>
          <select id="monthSelect" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option>January</option>
            <option>February</option>
            <option>March</option>
            <option>April</option>
            <option>May</option>
            <option>June</option>
            <option>July</option>
            <option>August</option>
            <option>September</option>
            <option>October</option>
            <option>November</option>
            <option>December</option>
          </select>
        </div>

        <!-- Year Selector -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">📅 Year</label>
          <input type="number" id="yearSelect" min="2020" max="2030" value="2025" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
        </div>

        <!-- Status Filter -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">📋 Status</label>
          <select id="statusFilter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">All Status</option>
            <option value="pending">Pending</option>
            <option value="approved">Approved</option>
            <option value="denied">Denied</option>
          </select>
        </div>

        <!-- Search -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">🔍 Search</label>
          <input type="text" id="searchInput" placeholder="Search events..." class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
        </div>
      </div>

      <div class="flex gap-2">
        <button id="filterBtn" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
          🔍 Apply Filters
        </button>
        <button id="resetBtn" class="px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition font-medium">
          🔄 Reset
        </button>
        <button id="exportBtn" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition font-medium ml-auto">
          💾 Export CSV
        </button>
      </div>
    </div>

    <!-- Calendar Grid -->
    <div class="grid md:grid-cols-7 gap-2 mb-8 bg-white rounded-xl shadow-md p-6">
      <!-- Day headers -->
      <div class="text-center font-bold text-gray-600 py-2">SUN</div>
      <div class="text-center font-bold text-gray-600 py-2">MON</div>
      <div class="text-center font-bold text-gray-600 py-2">TUE</div>
      <div class="text-center font-bold text-gray-600 py-2">WED</div>
      <div class="text-center font-bold text-gray-600 py-2">THU</div>
      <div class="text-center font-bold text-gray-600 py-2">FRI</div>
      <div class="text-center font-bold text-gray-600 py-2">SAT</div>

      <!-- Calendar days will be populated here -->
      <div id="calendarDays"></div>
    </div>

    <!-- Events List -->
    <div class="bg-white rounded-xl shadow-md p-6">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">📋 Events List</h2>
      
      <div id="eventsList" class="space-y-4">
        <p class="text-gray-600 text-center py-8">Loading events...</p>
      </div>
    </div>
  </div>

  {{> footer }}

  <script>
    let allEvents = [];
    const today = new Date();
    let currentMonth = today.getMonth();
    let currentYear = today.getFullYear();

    // Initialize calendar
    function initCalendar() {
      document.getElementById('monthSelect').selectedIndex = currentMonth;
      document.getElementById('yearSelect').value = currentYear;
      renderCalendar();
      loadEvents();
    }

    // Render calendar
    function renderCalendar() {
      const monthSelect = document.getElementById('monthSelect');
      const yearSelect = document.getElementById('yearSelect');
      currentMonth = monthSelect.selectedIndex;
      currentYear = parseInt(yearSelect.value);

      const firstDay = new Date(currentYear, currentMonth, 1);
      const lastDay = new Date(currentYear, currentMonth + 1, 0);
      const daysInMonth = lastDay.getDate();
      const startingDayOfWeek = firstDay.getDay();

      let html = '';

      // Empty cells before first day
      for (let i = 0; i < startingDayOfWeek; i++) {
        html += '<div class="p-2 bg-gray-50 rounded"></div>';
      }

      // Days of month
      for (let day = 1; day <= daysInMonth; day++) {
        const date = new Date(currentYear, currentMonth, day);
        const dateStr = date.toISOString().split('T')[0];
        const eventsOnDay = allEvents.filter(e => e.event_date.split('T')[0] === dateStr);
        
        let dayClass = 'p-2 rounded border-2 border-gray-200 min-h-24 hover:shadow-md transition cursor-pointer';
        if (date.toDateString() === today.toDateString()) {
          dayClass = 'p-2 rounded border-2 border-blue-500 min-h-24 bg-blue-50';
        }

        html += `
          <div class="${dayClass}">
            <div class="font-bold text-gray-800 mb-1">${day}</div>
            <div class="space-y-1">
              ${eventsOnDay.slice(0, 2).map(e => `
                <div class="text-xs px-2 py-1 rounded truncate cursor-pointer ${
                  e.status === 'approved' ? 'bg-green-100 text-green-700' :
                  e.status === 'pending' ? 'bg-yellow-100 text-yellow-700' :
                  'bg-red-100 text-red-700'
                }">
                  ${e.event_title}
                </div>
              `).join('')}
              ${eventsOnDay.length > 2 ? `<div class="text-xs text-gray-600 px-2">+${eventsOnDay.length - 2} more</div>` : ''}
            </div>
          </div>
        `;
      }

      document.getElementById('calendarDays').innerHTML = html;
    }

    // Load and display events
    function loadEvents() {
      const status = document.getElementById('statusFilter').value;
      const search = document.getElementById('searchInput').value;

      let filtered = allEvents;
      
      if (status) {
        filtered = filtered.filter(e => e.status === status);
      }
      
      if (search) {
        filtered = filtered.filter(e => 
          e.event_title.toLowerCase().includes(search.toLowerCase()) ||
          e.venue.toLowerCase().includes(search.toLowerCase())
        );
      }

      const eventsList = document.getElementById('eventsList');
      
      if (filtered.length === 0) {
        eventsList.innerHTML = '<p class="text-gray-600 text-center py-8">No events found</p>';
        return;
      }

      eventsList.innerHTML = filtered.map(event => `
        <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition">
          <div class="flex justify-between items-start mb-2">
            <div>
              <h3 class="font-bold text-lg text-gray-800">${event.event_title}</h3>
              <p class="text-sm text-gray-600">by ${event.organizer_name}</p>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-semibold ${
              event.status === 'approved' ? 'bg-green-100 text-green-700' :
              event.status === 'pending' ? 'bg-yellow-100 text-yellow-700' :
              'bg-red-100 text-red-700'
            }">
              ${event.status.toUpperCase()}
            </span>
          </div>
          <p class="text-sm text-gray-600 mb-2">📍 ${event.venue}</p>
          <p class="text-sm text-gray-600 mb-2">📅 ${new Date(event.event_date).toLocaleDateString()}</p>
          <p class="text-sm text-gray-600 line-clamp-2">${event.purpose}</p>
        </div>
      `).join('');
    }

    // Fetch events from server
    async function fetchEvents() {
      try {
        const response = await fetch('/api/events', {
          headers: { 'Accept': 'application/json' }
        });
        const result = await response.json();
        if (result.success) {
          allEvents = result.events || [];
          renderCalendar();
          loadEvents();
        }
      } catch (error) {
        console.error('Error fetching events:', error);
      }
    }

    // Event listeners
    document.getElementById('monthSelect').addEventListener('change', renderCalendar);
    document.getElementById('yearSelect').addEventListener('change', renderCalendar);
    document.getElementById('filterBtn').addEventListener('click', loadEvents);
    document.getElementById('resetBtn').addEventListener('click', () => {
      document.getElementById('statusFilter').value = '';
      document.getElementById('searchInput').value = '';
      loadEvents();
    });
    document.getElementById('exportBtn').addEventListener('click', () => {
      window.location.href = '/api/export-csv';
    });

    // Initialize
    fetchEvents();
  </script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
      animation: fadeIn 0.5s ease-out forwards;
    }
  </style>

</body>
</html>
