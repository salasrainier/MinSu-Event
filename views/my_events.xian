{{> head }}
<body class="bg-gray-100 min-h-screen">

  <!-- Navigation Bar -->
  <nav class="bg-white shadow-sm sticky top-0 z-50 border-b border-gray-300">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex justify-between items-center h-14">
        <div class="flex items-center gap-3">
          <img src="/uploads/OIP.jpg" alt="MSU Logo" class="w-10 h-10 rounded-full object-cover" />
          <h1 class="text-xl font-bold text-green-600 hidden sm:block">My Events</h1>
        </div>

        <div class="flex items-center gap-2">
          <a href="/api/feed" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg transition">
            Back to Feed
          </a>
          <a href="/auth/logout" class="p-2 text-gray-600 hover:bg-gray-100 rounded-full transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <div class="max-w-6xl mx-auto px-4 py-6">

    <!-- Alert Messages -->
    {{#if success_msg}}
      <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg">
        {{success_msg}}
      </div>
    {{/if}}
    {{#if error_msg}}
      <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg">
        {{error_msg}}
      </div>
    {{/if}}

    <!-- Active Events -->
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">🟢 Active Events</h2>
      
      {{#if activeEvents.length}}
        <div class="grid gap-4 md:grid-cols-2">
          {{#each activeEvents}}
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
            <h3 class="text-lg font-bold text-gray-900 mb-2">{{event_title}}</h3>
            <p class="text-sm text-gray-600 mb-3">{{purpose}}</p>
            
            <div class="flex items-center gap-4 text-sm text-gray-600 mb-3">
              <div class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <span>{{formatDate event_date "MMM D"}}</span>
              </div>
              <div class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                <span>{{participantCount}} joined</span>
              </div>
            </div>

            <button class="close-event w-full px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-semibold" data-event-id="{{id}}">
              🔒 Close Event
            </button>
          </div>
          {{/each}}
        </div>
      {{else}}
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center">
          <p class="text-gray-600">No active events</p>
        </div>
      {{/if}}
    </div>

    <!-- Expired Events -->
    <div>
      <h2 class="text-2xl font-bold text-gray-900 mb-4">⏰ Expired Events</h2>
      
      {{#if expiredEvents.length}}
        <div class="grid gap-4 md:grid-cols-2">
          {{#each expiredEvents}}
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 opacity-75">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-lg font-bold text-gray-900">{{event_title}}</h3>
              <span class="px-2 py-1 bg-red-100 text-red-700 text-xs rounded-full font-semibold">EXPIRED</span>
            </div>
            <p class="text-sm text-gray-600 mb-3">{{purpose}}</p>
            
            <div class="flex items-center gap-4 text-sm text-gray-600 mb-3">
              <div class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <span>{{formatDate event_date "MMM D"}}</span>
              </div>
              <div class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                <span>{{participantCount}} joined</span>
              </div>
            </div>

            <button class="reopen-event w-full px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition font-semibold" data-event-id="{{id}}">
              🔄 Reopen Event
            </button>
          </div>
          {{/each}}
        </div>
      {{else}}
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center">
          <p class="text-gray-600">No expired events</p>
        </div>
      {{/if}}
    </div>

  </div>

<script>
// Reopen Event
document.querySelectorAll('.reopen-event').forEach(btn => {
  btn.addEventListener('click', async function() {
    const eventId = this.dataset.eventId;
    
    if (!confirm('Are you sure you want to reopen this event?')) return;
    
    try {
      const res = await fetch(`/api/events/${eventId}/reopen`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      
      const data = await res.json();
      if (data.success) {
        location.reload();
      } else {
        alert(data.message);
      }
    } catch (error) {
      console.error('Reopen error:', error);
      alert('Failed to reopen event');
    }
  });
});

// Close Event
document.querySelectorAll('.close-event').forEach(btn => {
  btn.addEventListener('click', async function() {
    const eventId = this.dataset.eventId;
    
    if (!confirm('Are you sure you want to close this event? Participants will no longer be able to join.')) return;
    
    try {
      const res = await fetch(`/api/events/${eventId}/close`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      
      const data = await res.json();
      if (data.success) {
        location.reload();
      } else {
        alert(data.message);
      }
    } catch (error) {
      console.error('Close error:', error);
      alert('Failed to close event');
    }
  });
});
</script>

</body>
</html>
