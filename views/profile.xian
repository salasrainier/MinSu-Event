{{> head }}
<body class="bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50 min-h-screen">

  {{> navbar }}

  <div class="container mx-auto px-4 py-12 max-w-4xl">
    
    <!-- Header -->
    <div class="text-center mb-12 animate-fade-in">
      <div class="text-6xl mb-4">👤</div>
      <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600 mb-2">
        My Profile
      </h1>
      <p class="text-gray-600">Update your information and profile picture</p>
    </div>

    <!-- Alert Messages -->
    {{#if success_msg}}
      <div class="mb-6 p-4 bg-green-100 border-l-4 border-green-500 text-green-700 rounded-xl flex items-center gap-3 animate-slide-in shadow-lg">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="font-bold">{{success_msg}}</p>
      </div>
    {{/if}}

    {{#if error_msg}}
      <div class="mb-6 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded-xl flex items-center gap-3 animate-slide-in shadow-lg">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="font-bold">{{error_msg}}</p>
      </div>
    {{/if}}

    <div class="grid md:grid-cols-3 gap-8">
      
      <!-- Left Side - Profile Picture -->
      <div class="md:col-span-1">
        <div class="bg-white rounded-3xl shadow-2xl p-8 border-4 border-blue-200 text-center animate-slide-in-left">
          <h2 class="text-2xl font-black text-gray-800 mb-6">Profile Picture</h2>
          
          <!-- Current Profile Picture -->
          <div class="mb-6">
            {{#if user.profile_picture}}
            <img id="profilePreview" src="{{user.profile_picture}}" alt="{{user.name}}" class="w-40 h-40 rounded-full object-cover mx-auto border-8 border-blue-300 shadow-xl" />
            {{else}}
            <div id="profilePreview" class="w-40 h-40 rounded-full bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-white font-black text-6xl mx-auto border-8 border-blue-300 shadow-xl">
              {{substring user.name 0 1}}
            </div>
            {{/if}}
          </div>

          <!-- Upload Form -->
          <form action="/profile/upload-picture" method="POST" enctype="multipart/form-data" class="space-y-4">
            <div>
              <label for="profilePicture" class="block w-full px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-500 text-white rounded-2xl font-bold cursor-pointer hover:from-blue-600 hover:to-purple-600 transition shadow-lg hover:shadow-xl transform hover:scale-105">
                <svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                Choose Photo
              </label>
              <input type="file" id="profilePicture" name="profile_picture" accept="image/*" class="hidden" onchange="previewImage(event)" />
            </div>
            <p class="text-xs text-gray-500">JPG, PNG or GIF (Max 5MB)</p>
            <button type="submit" class="w-full px-6 py-3 bg-gradient-to-r from-green-500 to-emerald-500 text-white rounded-2xl font-bold hover:from-green-600 hover:to-emerald-600 transition shadow-lg hover:shadow-xl transform hover:scale-105">
              <svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
              </svg>
              Upload Picture
            </button>
          </form>
        </div>
      </div>

      <!-- Right Side - Profile Information -->
      <div class="md:col-span-2">
        <div class="bg-white rounded-3xl shadow-2xl p-8 border-4 border-purple-200 animate-slide-in-right">
          <h2 class="text-2xl font-black text-gray-800 mb-6">Profile Information</h2>
          
          <form action="/profile/update" method="POST" class="space-y-6">
            
            <!-- Name -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                Full Name
              </label>
              <input type="text" name="name" value="{{user.name}}" required class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-300 rounded-xl focus:outline-none focus:ring-4 focus:ring-blue-300 focus:border-blue-500 transition font-medium" />
            </div>

            <!-- Email -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                Email Address
              </label>
              <input type="email" name="email" value="{{user.email}}" required class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-300 rounded-xl focus:outline-none focus:ring-4 focus:ring-blue-300 focus:border-blue-500 transition font-medium" />
            </div>

            <!-- Department -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
                Department/Office/Course
              </label>
              <input 
                type="text" 
                name="department" 
                value="{{user.department}}" 
                list="departmentList" 
                placeholder="Select or type your course/department"
                required 
                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-300 rounded-xl focus:outline-none focus:ring-4 focus:ring-blue-300 focus:border-blue-500 transition font-medium" 
              />
              <datalist id="departmentList">
                <!-- Colleges/Departments -->
                <option value="CCS">CCS - College of Computer Studies</option>
                <option value="CBM">CBM - College of Business Management</option>
                <option value="CAAF">CAAF - College of Agriculture, Aquatic and Forestry</option>
                <option value="CAS">CAS - College of Arts and Sciences</option>
                <option value="CCJE">CCJE - College of Criminal Justice Education</option>
                <option value="CTE">CTE - College of Teacher Education</option>
                <option value="IABE">IABE - Institute of Accountancy and Business Economics</option>
                <option value="IF">IF - Institute of Fisheries</option>
                
                <!-- Academic Programs -->
                <option value="BSIT">BS in Information Technology</option>
                <option value="BSCpE">BS in Computer Engineering</option>
                <option value="BSCrim">BS Criminology</option>
                <option value="BSFisheries">BS in Fisheries</option>
                <option value="ABPolSci">AB Political Science</option>
                <option value="BEEd">Bachelor of Elementary Education</option>
                <option value="BSEd-English">BSEd Major in English</option>
                <option value="BSEd-Math">BSEd Major in Mathematics</option>
                <option value="BSEd-Science">BSEd Major in Science</option>
                
                <!-- Administrative Offices -->
                <option value="OCS">OCS - Office of the Campus Director</option>
                <option value="OSAS">OSAS - Office of Student Affairs and Services</option>
                <option value="REGISTRAR">Registrar's Office</option>
                <option value="ACCOUNTING">Accounting Office</option>
                <option value="CASHIER">Cashier's Office</option>
                <option value="HRMO">HRMO - Human Resource Management Office</option>
                <option value="LIBRARY">Library</option>
                <option value="GUIDANCE">Guidance and Counseling Office</option>
                <option value="CLINIC">Medical/Dental Clinic</option>
                
                <!-- Support Services -->
                <option value="ITS">ITS - Information Technology Services</option>
                <option value="RESEARCH">Research and Development Office</option>
                <option value="EXTENSION">Extension Services Office</option>
                <option value="QA">Quality Assurance Office</option>
                <option value="PLANNING">Planning and Development Office</option>
                <option value="SUPPLY">Supply Office</option>
                <option value="GSO">GSO - General Services Office</option>
                <option value="SECURITY">Security Office</option>
              </datalist>
              <p class="text-xs text-gray-500 mt-1">💡 Select from dropdown or type your course if not listed</p>
            </div>

            <!-- Role (Read-only) -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                </svg>
                Role
              </label>
              <input type="text" value="{{user.role}}" readonly class="w-full px-4 py-3 bg-gray-200 border-2 border-gray-300 rounded-xl font-bold text-gray-600 capitalize cursor-not-allowed" />
              <p class="text-xs text-gray-500 mt-1">Contact admin to change your role</p>
            </div>

            <!-- Save Button -->
            <button type="submit" class="w-full px-6 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-2xl font-black text-lg hover:from-purple-600 hover:to-pink-600 transition shadow-xl hover:shadow-2xl transform hover:scale-105">
              <svg class="w-6 h-6 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Save Changes
            </button>
          </form>
        </div>
      </div>

    </div>

  </div>

  {{> footer }}

  <script>
    function previewImage(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const preview = document.getElementById('profilePreview');
          if (preview.tagName === 'IMG') {
            preview.src = e.target.result;
          } else {
            // Replace div with img
            const img = document.createElement('img');
            img.id = 'profilePreview';
            img.src = e.target.result;
            img.className = 'w-40 h-40 rounded-full object-cover mx-auto border-8 border-blue-300 shadow-xl';
            preview.parentNode.replaceChild(img, preview);
          }
        };
        reader.readAsDataURL(file);
      }
    }

    // Debug form submission
    document.addEventListener('DOMContentLoaded', function() {
      const profileForm = document.querySelector('form[action="/profile/update"]');
      if (profileForm) {
        profileForm.addEventListener('submit', function(e) {
          console.log('🔥 Form submitting!');
          console.log('Form data:', new FormData(this));
          const formData = new FormData(this);
          for (let [key, value] of formData.entries()) {
            console.log(`  ${key}: ${value}`);
          }
        });
      }
    });
  </script>

  <style>
    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes slide-in {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes slide-in-left {
      from { opacity: 0; transform: translateX(-50px); }
      to { opacity: 1; transform: translateX(0); }
    }

    @keyframes slide-in-right {
      from { opacity: 0; transform: translateX(50px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .animate-fade-in { animation: fade-in 0.6s ease-out; }
    .animate-slide-in { animation: slide-in 0.4s ease-out; }
    .animate-slide-in-left { animation: slide-in-left 0.6s ease-out; }
    .animate-slide-in-right { animation: slide-in-right 0.6s ease-out; }
  </style>

</body>
</html>
