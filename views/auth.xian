{{> head}}
<body class="flex items-center justify-center min-h-screen bg-gray-100">

<div class="relative w-[800px] h-[500px] rounded-xl shadow-xl overflow-hidden">

  <!-- FORMS CONTAINER -->
  <div id="formsContainer" class="absolute top-0 left-0 w-1/2 h-full bg-white flex flex-col justify-center items-center px-10 transition-all duration-700">
    
    <!-- LOGIN -->
    <form id="loginForm" method="POST" action="/auth/login" class="w-full max-w-sm flex flex-col gap-3">
      <h2 class="text-3xl font-bold text-center mb-5">Login</h2>
      <input type="email" name="email" placeholder="Email" class="p-3 border rounded" required>
      <input type="password" name="password" placeholder="Password" class="p-3 border rounded" required>
      <button class="bg-blue-600 hover:bg-blue-700 text-white py-2 rounded font-semibold">Sign In</button>
    </form>

    <!-- REGISTER -->
    <form id="registerForm" method="POST" action="/auth/register" class="hidden w-full max-w-sm flex flex-col gap-3">
      <h2 class="text-3xl font-bold text-center mb-5">Create Account</h2>
      <input type="text" name="name" placeholder="Full Name" class="p-3 border rounded" required>
      <input type="email" name="email" placeholder="Email" class="p-3 border rounded" required>
      <input type="password" name="password" placeholder="Password" class="p-3 border rounded" required>
      <button class="bg-blue-600 hover:bg-blue-700 text-white py-2 rounded font-semibold">Sign Up</button>
    </form>

  </div>

  <!-- OVERLAY -->
  <div id="overlay" class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-r from-teal-500 to-blue-600 text-white flex flex-col justify-center items-center px-10 text-center transition-all duration-700">
    <h2 id="overlayTitle" class="text-3xl font-bold mb-3">New Here?</h2>
    <p id="overlayText" class="text-sm mb-6">Sign up and discover new opportunities!</p>
    <button id="toggleBtn" class="border border-white px-6 py-2 rounded hover:bg-white hover:text-blue-600 transition">Sign Up</button>
  </div>

</div>

<script>
let isLogin = true;
const loginForm = document.getElementById("loginForm");
const registerForm = document.getElementById("registerForm");
const formsContainer = document.getElementById("formsContainer");
const overlay = document.getElementById("overlay");
const toggleBtn = document.getElementById("toggleBtn");
const overlayTitle = document.getElementById("overlayTitle");
const overlayText = document.getElementById("overlayText");

toggleBtn.addEventListener("click", () => {
  if (isLogin) {
    // Show REGISTER
    loginForm.classList.add("hidden");
    registerForm.classList.remove("hidden");
    formsContainer.style.transform = "translateX(100%)";
    overlay.style.transform = "translateX(-100%)";
    overlayTitle.innerText = "Welcome Back!";
    overlayText.innerText = "Please login again to continue.";
    toggleBtn.innerText = "Sign In";
  } else {
    // Show LOGIN
    loginForm.classList.remove("hidden");
    registerForm.classList.add("hidden");
    formsContainer.style.transform = "translateX(0)";
    overlay.style.transform = "translateX(0)";
    overlayTitle.innerText = "New Here?";
    overlayText.innerText = "Sign up and discover new opportunities!";
    toggleBtn.innerText = "Sign Up";
  }
  isLogin = !isLogin;
});
</script>

</body>
